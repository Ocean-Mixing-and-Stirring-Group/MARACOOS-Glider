# INTERVAL              Seconds since last stored value, 0 is store every value
# STATE                 State of glider (dive, hover, climb), 15 is always store
# HALFYOS               # of dive/climbs in this segment to record for, -1 store for all
# YO_DUTY_CYCLE         Store data every n'th yo in this segment, -1 is every dive/climb

# --------------------------------------------------------------------
# SENSOR NAME           INTERVAL  STATE     HALFYOS   YO_DUTY_CYCLE
# (Defaults)            0         15        -1        -1
# --------------------------------------------------------------------

# 2020/3/5		dkaragon	added iridium call/dialed
# 2020/10/6		dkaragon	removed old notes since may be transferring this back and forth a lot
# 2020/10/15	dkaragon	created and implemented.  Too much whale time need to cut back other files, also beh_aborts during transfers
# 2021/12/14	dkaragon	cleaned up was about 18KB/3 hrs.  Most of it state, removed some sensors.
# 2023/04/10	dkaragon	tried to adapt to deep glider


# Basic Data
  m_present_time
  
  m_tot_num_inflections			900	8
  
  m_leakdetect_voltage  		900
  m_leakdetect_voltage_forward	900
  m_leakdetect_voltage_science	900
  m_digifin_leakdetect_reading	900
  
  m_veh_temp            		900
  m_coulomb_amphr_total			900
  m_vacuum              		900
  m_battery_inst				300		7	2
  m_bms_emergency_battery_voltage	900	15	-1	2
  m_iridium_call_num			0		8
  m_iridium_dialed_num			0		8
  
  x_low_power_status			900		7	2
  
  
# Positioning and Waypoint
  m_gps_lon
  m_gps_lat
  m_lat							900
  m_lon							900
  m_gps_status					30
  m_gps_mag_var

  m_water_vx
  m_water_vy
  m_x_lmc						60	8
  m_y_lmc						60	8
  c_wpt_x_lmc					60	8
  c_wpt_y_lmc					60	8
  c_wpt_lat
  c_wpt_lon
  m_avg_speed					900


# Flight Parameters
  f_fin_offset
  x_fin_max
  u_hd_fin_ap_gain
  u_hd_fin_ap_igain
  u_hd_fin_ap_dgain
  u_heading_deadband
  u_low_power_cycle_time
  u_low_power_hd_fin_ap_gain
  u_low_power_hd_fin_ap_igain
  u_low_power_hd_fin_ap_dgain
  
# Yo params
  c_climb_target_depth			900	7	2
  c_dive_target_depth			900	7	2
  x_current_target_altitude		900	7	1

# Engineering Data
  m_pitch               	120	7	8	2
  m_roll                	360 7   4	2

  c_heading             	900 7
  m_heading					900	7
  m_hdg_error				120	7	4	2
  m_hdg_derror				240	7	4	2
  m_hdg_ierror				240	7	4	2
  m_fin                 	120 7   4	2
  c_fin						900	7	4	2

  m_battpos             	600	7	8	2
  c_de_oil_vol	   			720	7   2
  m_de_oil_vol				360	7	2

  m_pressure            	360
  m_depth                   30  8
  m_depth_rate_avg_final	300	7	2
  
  m_raw_altitude			45	3	1
  m_water_depth				45
  
  
# CTD Data
  sci_water_pressure		1800
  