
# 2017/8/1 9:26 EST - trying gains a little lower, from 1 to .75

sensor: u_hover_bpump_ap_gain_shallow(cc/m)     .75 #proportional gain, shallow bpump
sensor: u_hover_bpump_ap_dgain_shallow(cc-s/m)  .75 #derivative gain, shallow bpump


# BALLAST PUMP CC
sensor: f_neutral_ballast(cc) 		  100		
sensor: x_hover_ballast_shallow(cc) 25		
