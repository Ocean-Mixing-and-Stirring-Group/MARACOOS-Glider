# 2015624	dkaragon	initial
# 2015722 dkaragon	iridium problems, set failover to 5
# 20160114	dkaragon	updated, fin offset to 0; pitch db back to 3; steering params; fin deadband
# 2021/5/25	dkaragon	cleaned up, refurbished

# Critical Settings
sensor u_reqd_depth_at_surface(m) 			3.5
sensor u_iridium_failover_retries(nodim) 	7
sensor u_abort_max_burn_time(sec) 			43200 	# 12 hours (default 4)

