# PREPARE TO DIVE : wait 12 min for GPS
behavior: prepare_to_dive
    b_arg: start_when(enum)         0   # 0-immediately
    b_arg: wait_time(sec)           720 # wait time

	
# SENSORS_IN : not sure what this does, assuming remaining sensor update
behavior: sensors_in
